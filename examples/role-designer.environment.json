{
  "version": 1,
  "title": "人事も同列：並列ロールと専用DinDの設計案",
  "notes": "合成サンプル。共通SBX内のruntime Dockerに、人事・実装・レビューを並列配置し、各ロールが専用DinDを持つ。並列起動・権限・資源・マウントの隔離は未検証。",
  "nodes": [
    {
      "id": "host",
      "kind": "host",
      "label": "PC / WSL",
      "status": "proposed"
    },
    {
      "id": "sandbox",
      "kind": "sbx",
      "parent": "host",
      "label": "共通SBX：エージェント実行基盤",
      "status": "proposed",
      "notes": "VM境界は共通SBX。ロール間はコンテナ境界で、独立VMではない。"
    },
    {
      "id": "runtime",
      "kind": "container",
      "parent": "sandbox",
      "label": "runtime Docker：ロールの起動・再接続",
      "status": "proposed",
      "refs": [
        "runtime/compose.yaml"
      ],
      "notes": "人事を含む全ロールを同列の作業コンテナとして起動する。"
    },
    {
      "id": "runtime-docker",
      "kind": "daemon",
      "parent": "runtime",
      "label": "実行基盤のDocker daemon",
      "status": "proposed",
      "notes": "ロールコンテナの起動専用。ホストsocketの共有は想定しない。"
    },
    {
      "id": "people-container",
      "kind": "container",
      "parent": "runtime",
      "label": "人事のロール環境",
      "status": "proposed",
      "refs": [
        "roles/people/compose.yaml"
      ],
      "notes": "専用のユーザー構成・作業領域・DinD daemonを持つ。並列実行時のCPU/メモリ・権限・通信は実証して確定。"
    },
    {
      "id": "people",
      "kind": "role",
      "parent": "people-container",
      "label": "人事",
      "status": "proposed",
      "notes": "ロールのユーザー構成とDocker作業場・検証計画を作成する。自分も他と同じロールコンテナで働く。"
    },
    {
      "id": "people-docker",
      "kind": "daemon",
      "parent": "people-container",
      "label": "人事専用DinD",
      "status": "proposed",
      "notes": "ロール内のビルドとテストに使用する専用daemon。ソケット・状態・イメージを他のロールと共有しない設計案。"
    },
    {
      "id": "people-config",
      "kind": "config",
      "parent": "people-container",
      "label": "人事のユーザー構成",
      "status": "proposed",
      "refs": [
        "roles/people/agent-config/config.toml",
        "roles/people/agent-config/AGENTS.md",
        "roles/people/agent-config/skills/"
      ]
    },
    {
      "id": "builder-container",
      "kind": "container",
      "parent": "runtime",
      "label": "実装担当のロール環境",
      "status": "proposed",
      "refs": [
        "roles/builder/compose.yaml"
      ],
      "notes": "専用のユーザー構成・作業領域・DinD daemonを持つ。並列実行時のCPU/メモリ・権限・通信は実証して確定。"
    },
    {
      "id": "builder",
      "kind": "role",
      "parent": "builder-container",
      "label": "実装担当",
      "status": "proposed",
      "notes": "割り当てられた案件を実装し、専用Dockerでビルドと検証を行う。"
    },
    {
      "id": "builder-docker",
      "kind": "daemon",
      "parent": "builder-container",
      "label": "実装担当専用DinD",
      "status": "proposed",
      "notes": "ロール内のビルドとテストに使用する専用daemon。ソケット・状態・イメージを他のロールと共有しない設計案。"
    },
    {
      "id": "builder-config",
      "kind": "config",
      "parent": "builder-container",
      "label": "実装担当のユーザー構成",
      "status": "proposed",
      "refs": [
        "roles/builder/agent-config/config.toml",
        "roles/builder/agent-config/AGENTS.md",
        "roles/builder/agent-config/skills/"
      ]
    },
    {
      "id": "reviewer-container",
      "kind": "container",
      "parent": "runtime",
      "label": "レビュー担当のロール環境",
      "status": "proposed",
      "refs": [
        "roles/reviewer/compose.yaml"
      ],
      "notes": "専用のユーザー構成・作業領域・DinD daemonを持つ。並列実行時のCPU/メモリ・権限・通信は実証して確定。"
    },
    {
      "id": "reviewer",
      "kind": "role",
      "parent": "reviewer-container",
      "label": "レビュー担当",
      "status": "proposed",
      "notes": "対象のコピーを独立して検証し、根拠のあるレビューを返す。"
    },
    {
      "id": "reviewer-docker",
      "kind": "daemon",
      "parent": "reviewer-container",
      "label": "レビュー担当専用DinD",
      "status": "proposed",
      "notes": "ロール内のビルドとテストに使用する専用daemon。ソケット・状態・イメージを他のロールと共有しない設計案。"
    },
    {
      "id": "reviewer-config",
      "kind": "config",
      "parent": "reviewer-container",
      "label": "レビュー担当のユーザー構成",
      "status": "proposed",
      "refs": [
        "roles/reviewer/agent-config/config.toml",
        "roles/reviewer/agent-config/AGENTS.md",
        "roles/reviewer/agent-config/skills/"
      ]
    },
    {
      "id": "catalog",
      "kind": "workspace",
      "parent": "host",
      "label": "ロール定義カタログ",
      "status": "proposed",
      "refs": [
        "roles/"
      ],
      "notes": "人事が定義を提案し、検証された版をruntimeが利用する。人事自身がホストのdaemonや起動権限を自由に変更するものではない。"
    }
  ],
  "links": [
    {
      "id": "people-launch",
      "kind": "docker",
      "from": "runtime-docker",
      "to": "people-container",
      "label": "同列の作業場として起動",
      "status": "proposed"
    },
    {
      "id": "people-config-use",
      "kind": "config",
      "from": "people",
      "to": "people-config",
      "label": "役割別の設定を利用",
      "status": "proposed"
    },
    {
      "id": "people-build",
      "kind": "docker",
      "from": "people",
      "to": "people-docker",
      "label": "専用daemonで構築・検証",
      "status": "proposed"
    },
    {
      "id": "builder-launch",
      "kind": "docker",
      "from": "runtime-docker",
      "to": "builder-container",
      "label": "同列の作業場として起動",
      "status": "proposed"
    },
    {
      "id": "builder-config-use",
      "kind": "config",
      "from": "builder",
      "to": "builder-config",
      "label": "役割別の設定を利用",
      "status": "proposed"
    },
    {
      "id": "builder-build",
      "kind": "docker",
      "from": "builder",
      "to": "builder-docker",
      "label": "専用daemonで構築・検証",
      "status": "proposed"
    },
    {
      "id": "reviewer-launch",
      "kind": "docker",
      "from": "runtime-docker",
      "to": "reviewer-container",
      "label": "同列の作業場として起動",
      "status": "proposed"
    },
    {
      "id": "reviewer-config-use",
      "kind": "config",
      "from": "reviewer",
      "to": "reviewer-config",
      "label": "役割別の設定を利用",
      "status": "proposed"
    },
    {
      "id": "reviewer-build",
      "kind": "docker",
      "from": "reviewer",
      "to": "reviewer-docker",
      "label": "専用daemonで構築・検証",
      "status": "proposed"
    },
    {
      "id": "people-output",
      "kind": "mount",
      "from": "people-container",
      "to": "catalog",
      "access": "rw",
      "target": "/workspace/roles",
      "label": "ロールと作業場の定義を作成",
      "status": "proposed"
    },
    {
      "id": "runtime-catalog",
      "kind": "mount",
      "from": "runtime",
      "to": "catalog",
      "access": "ro",
      "target": "/opt/role-catalog",
      "label": "採用済み構成を利用",
      "status": "proposed"
    }
  ]
}
