{
  "version": 1,
  "title": "人事も同列：実行基盤のDinDで並列ロールを起動",
  "notes": "合成サンプル。共通SBX内のruntime DockerがDinDで人事・実装・レビューの作業コンテナを並列起動する。各ロールはユーザー構成と作業領域を持つ。並列起動・資源・マウントは未検証。",
  "nodes": [
    {
      "id": "host",
      "kind": "host",
      "label": "PC / WSL",
      "status": "proposed"
    },
    {
      "id": "sandbox",
      "kind": "sbx",
      "parent": "host",
      "label": "共通SBX：エージェント実行基盤",
      "status": "proposed",
      "notes": "VM境界は共通SBX。ロール間はコンテナ境界で、独立VMではない。"
    },
    {
      "id": "runtime",
      "kind": "container",
      "parent": "sandbox",
      "label": "runtime Docker：ロールの起動・再接続",
      "status": "proposed",
      "refs": [
        "runtime/compose.yaml"
      ],
      "notes": "人事を含む全ロールを同列の作業コンテナとして起動する。"
    },
    {
      "id": "runtime-docker",
      "kind": "daemon",
      "parent": "runtime",
      "label": "実行基盤のDinD",
      "status": "proposed",
      "notes": "ロール用コンテナを並列起動する実行基盤のdaemon。各ロールへsocketを共有するかどうかは別の設計事項で、ここでは接続を付与しない。"
    },
    {
      "id": "people-container",
      "kind": "container",
      "parent": "runtime",
      "label": "人事のロール環境",
      "status": "proposed",
      "refs": [
        "roles/people/compose.yaml"
      ],
      "notes": "ユーザー構成と作業領域を持つロール用コンテナ。ロール内にDocker daemonを常設しない。Docker操作が必要な場合の接続方法は未決定。"
    },
    {
      "id": "people",
      "kind": "role",
      "parent": "people-container",
      "label": "人事",
      "status": "proposed",
      "notes": "ロールのユーザー構成とDocker作業場・検証計画を作成する。自分も他と同じロールコンテナで働く。"
    },
    {
      "id": "people-config",
      "kind": "config",
      "parent": "people-container",
      "label": "人事のユーザー構成",
      "status": "proposed",
      "refs": [
        "roles/people/agent-config/config.toml",
        "roles/people/agent-config/AGENTS.md",
        "roles/people/agent-config/skills/"
      ]
    },
    {
      "id": "builder-container",
      "kind": "container",
      "parent": "runtime",
      "label": "実装担当のロール環境",
      "status": "proposed",
      "refs": [
        "roles/builder/compose.yaml"
      ],
      "notes": "ユーザー構成と作業領域を持つロール用コンテナ。ロール内にDocker daemonを常設しない。Docker操作が必要な場合の接続方法は未決定。"
    },
    {
      "id": "builder",
      "kind": "role",
      "parent": "builder-container",
      "label": "実装担当",
      "status": "proposed",
      "notes": "割り当てられた案件を実装・検証する。Docker操作が必要な場合の接続方法は未決定。"
    },
    {
      "id": "builder-config",
      "kind": "config",
      "parent": "builder-container",
      "label": "実装担当のユーザー構成",
      "status": "proposed",
      "refs": [
        "roles/builder/agent-config/config.toml",
        "roles/builder/agent-config/AGENTS.md",
        "roles/builder/agent-config/skills/"
      ]
    },
    {
      "id": "reviewer-container",
      "kind": "container",
      "parent": "runtime",
      "label": "レビュー担当のロール環境",
      "status": "proposed",
      "refs": [
        "roles/reviewer/compose.yaml"
      ],
      "notes": "ユーザー構成と作業領域を持つロール用コンテナ。ロール内にDocker daemonを常設しない。Docker操作が必要な場合の接続方法は未決定。"
    },
    {
      "id": "reviewer",
      "kind": "role",
      "parent": "reviewer-container",
      "label": "レビュー担当",
      "status": "proposed",
      "notes": "対象のコピーを独立して検証し、根拠のあるレビューを返す。"
    },
    {
      "id": "reviewer-config",
      "kind": "config",
      "parent": "reviewer-container",
      "label": "レビュー担当のユーザー構成",
      "status": "proposed",
      "refs": [
        "roles/reviewer/agent-config/config.toml",
        "roles/reviewer/agent-config/AGENTS.md",
        "roles/reviewer/agent-config/skills/"
      ]
    },
    {
      "id": "catalog",
      "kind": "workspace",
      "parent": "host",
      "label": "ロール定義カタログ",
      "status": "proposed",
      "refs": [
        "roles/"
      ],
      "notes": "人事が定義を提案し、検証された版をruntimeが利用する。人事自身がホストのdaemonや起動権限を自由に変更するものではない。"
    }
  ],
  "links": [
    {
      "id": "people-launch",
      "kind": "docker",
      "from": "runtime-docker",
      "to": "people-container",
      "label": "同列の作業場として起動",
      "status": "proposed"
    },
    {
      "id": "people-config-use",
      "kind": "config",
      "from": "people",
      "to": "people-config",
      "label": "役割別の設定を利用",
      "status": "proposed"
    },
    {
      "id": "builder-launch",
      "kind": "docker",
      "from": "runtime-docker",
      "to": "builder-container",
      "label": "同列の作業場として起動",
      "status": "proposed"
    },
    {
      "id": "builder-config-use",
      "kind": "config",
      "from": "builder",
      "to": "builder-config",
      "label": "役割別の設定を利用",
      "status": "proposed"
    },
    {
      "id": "reviewer-launch",
      "kind": "docker",
      "from": "runtime-docker",
      "to": "reviewer-container",
      "label": "同列の作業場として起動",
      "status": "proposed"
    },
    {
      "id": "reviewer-config-use",
      "kind": "config",
      "from": "reviewer",
      "to": "reviewer-config",
      "label": "役割別の設定を利用",
      "status": "proposed"
    },
    {
      "id": "people-output",
      "kind": "mount",
      "from": "people-container",
      "to": "catalog",
      "access": "rw",
      "target": "/workspace/roles",
      "label": "ロールと作業場の定義を作成",
      "status": "proposed"
    },
    {
      "id": "runtime-catalog",
      "kind": "mount",
      "from": "runtime",
      "to": "catalog",
      "access": "ro",
      "target": "/opt/role-catalog",
      "label": "採用済み構成を利用",
      "status": "proposed"
    }
  ]
}
